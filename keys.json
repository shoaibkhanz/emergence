{
  "global": {
    "cmd-e": "mod.open:jump"
  },
  "layout:emergence": {
    "cmd-shift-a": "tabs-plus.graph",
    "cmd-shift-e": "tabs-plus.excalidraw",
    "cmd-shift-f": "tabs-plus.files",
    "cmd-shift-g": "tabs-plus.changes",
    "cmd-shift-s": "tabs-plus.side",
    "cmd-shift-r": "tabs-plus.prs",
    "cmd-shift-k": "tabs-plus.skills",
    "cmd-shift-i": "tabs-plus.attention",
    "cmd-shift-o": "tabs-plus.worktrees",
    "cmd-shift-u": "tabs-plus.usage",
    "cmd-b": "tabs-plus.rail",
    "cmd-alt-b": "tabs-plus.thinner",
    "cmd-shift-/": "mod.open:emergence-keys",
    "cmd-alt-,": "mod.open:emergence-settings",
    "cmd-alt-/": "side.chat"
  },
  "mod:agent-graph": { "ctrl-h": "tabs-plus.back" },
  "mod:excalidraw": { "ctrl-h": "tabs-plus.back" },
  "mod:pr-review": { "ctrl-h": "tabs-plus.back" },
  "mod:skills": { "ctrl-h": "tabs-plus.back" },
  "mod:usage": { "ctrl-h": "tabs-plus.back" },
  "mod:spaces-plus": {
    "ctrl-j": "inbox.focus",
    "ctrl-l": "spaces-plus.back"
  },
  "mod:inbox": {
    "ctrl-k": "spaces-plus.focus",
    "ctrl-l": "inbox.back",
    "ctrl-j": "ports.down"
  },
  "mod:ports": {
    "ctrl-k": "inbox.focus",
    "ctrl-j": "side-chats.down",
    "ctrl-l": "ports.back"
  },
  "mod:side-chats": {
    "ctrl-k": "ports.up",
    "ctrl-l": "side-chats.back"
  }
}
